{# Shared series page body. The including page sets `seriesSlug`. #}
{% from "partials/book-card.njk" import bookCard %}
{%- set s = lookups.seriesBySlug[seriesSlug] -%}
{%- set seriesBooks = lookups.booksBySeries[seriesSlug] -%}

<section class="series-banner" style="--accent: {{ s.accent }}; --accent-soft: {{ s.accentSoft }}; --accent-text: {{ s.accentText or s.accent }};">
  <div class="wrap">
    <p class="eyebrow">{{ s.subject }}</p>
    <h1>{{ s.name }}</h1>
    <p>{{ s.blurb }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {% if seriesBooks.length %}
    <div class="series-start content-panel">
      <p class="eyebrow">A useful place to begin</p>
      <h2>Start with <a href="/book/{{ seriesBooks[0].slug }}/"><em>{{ seriesBooks[0].title }}</em></a> if…</h2>
      <p>{{ seriesBooks[0].bestFor }}</p>
    </div>
    {% endif %}
    <h2 class="section-title">Books in this series</h2>
    <p class="purchase-disclosure"><strong>Affiliate disclosure:</strong> Buy on Amazon buttons are affiliate links. As an Amazon Associate I earn from qualifying purchases. <a href="/affiliate-disclosure/">Details.</a></p>
    <div class="book-grid">
      {% for book in seriesBooks %}
        {{ bookCard(book, site, "") }}
      {% endfor %}
    </div>
    <div class="series-reading-guide content-panel">
      <h2>Talk about the stories together</h2>
      <p>Across this series, families and classrooms can explore {% for theme in seriesBooks[0].themes %}{% if not loop.first %}{% if loop.last %} and {% else %}, {% endif %}{% endif %}{{ theme }}{% endfor %}. Each product page includes plot-specific questions and a free preview when available.</p>
      <p><a href="https://club.madeoutofclayprod.com/printables">Pair the story with a free printable</a> or <a href="https://club.madeoutofclayprod.com/schools">ask about classroom use</a>.</p>
    </div>
  </div>
</section>

{% include "partials/reviews.njk" %}

<section class="cta-band" style="background: {{ s.accentText or s.accent }};">
  <div class="wrap wrap-narrow">
    <h2>Don't miss the next one</h2>
    <p>Join the family list for new {{ s.name }} releases and free printables.</p>
    {% set signupLocation = "series-" + seriesSlug %}
    {% include "partials/newsletter.njk" %}
  </div>
</section>
