{# Shared series page body. The including page sets `seriesSlug`. #}
{% from "partials/book-card.njk" import bookCard %}
{%- set s = lookups.seriesBySlug[seriesSlug] -%}
{%- set seriesBooks = lookups.booksBySeries[seriesSlug] -%}

<section class="series-banner" style="--accent: {{ s.accent }}; --accent-soft: {{ s.accentSoft }}; --accent-text: {{ s.accentText or s.accent }};">
  <div class="wrap">
    <p class="eyebrow">{{ s.subject }}</p>
    <h1>{{ s.name }}</h1>
    <p>{{ s.blurb }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">Books in this series</h2>
    <div class="book-grid">
      {% for book in seriesBooks %}
        {{ bookCard(book, site, "") }}
      {% endfor %}
    </div>
    <div class="series-reading-guide">
      <h2 class="section-title">Choose a story for today</h2>
      <p class="section-intro">Each book stands on its own. These summaries and themes can help parents, caregivers, librarians, and educators choose the best starting point.</p>
      {% for book in seriesBooks %}
      <article class="content-panel">
        <h3><a href="/book/{{ book.slug }}/">{{ book.title }}</a>{% if book.order %} <span class="subtle">· Book {{ book.order }}</span>{% endif %}</h3>
        <p>{{ book.blurb }}</p>
        <p><strong>Conversation themes:</strong>
          {% for theme in book.themes %}{% if not loop.first %}{% if loop.last %} and {% else %}, {% endif %}{% endif %}{{ theme }}{% endfor %}.
        </p>
        {% if book.status == "live" %}
        <p>Available as an 8.5×8.5 full-color hardcover for ages 2–7.</p>
        {% elseif book.readUrl %}
        <p>Coming soon. <a href="{{ book.readUrl }}">Read the free online preview.</a></p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% include "partials/reviews.njk" %}

<section class="cta-band" style="background: {{ s.accentText or s.accent }};">
  <div class="wrap wrap-narrow">
    <h2>Don't miss the next one</h2>
    <p>Join the family list for new {{ s.name }} releases and free printables.</p>
    {% set signupLocation = "series-" + seriesSlug %}
    {% include "partials/newsletter.njk" %}
  </div>
</section>
