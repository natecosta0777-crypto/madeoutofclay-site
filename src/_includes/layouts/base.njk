<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# --- Title + description (Spec §4.1) --- #}
  <title>{{ (metaTitle or title) | safe }}</title>
  <meta name="description" content="{{ (metaDescription or description) | metaDescription | safe }}">

  {# --- Canonical (Spec §4.1 / §4.7) --- #}
  {%- set pageUrl = page.url | absoluteUrl(site.url) -%}
  <link rel="canonical" href="{{ pageUrl }}">
  <meta name="robots" content="index, follow">

  {# --- Open Graph (Spec §4.1) --- #}
  {%- set ogImg = (ogImage or "/assets/og/default.png") | absoluteUrl(site.url) -%}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ (ogTitle or title) | safe }}">
  <meta property="og:description" content="{{ description | safe }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ ogImg }}">

  {# --- Twitter Card (Spec §4.1) --- #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ (ogTitle or title) | safe }}">
  <meta name="twitter:description" content="{{ description | safe }}">
  <meta name="twitter:image" content="{{ ogImg }}">

  <link rel="alternate" type="application/rss+xml" title="The Clay Journal" href="/feed.xml">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" as="style" href="/assets/css/styles.css">
  <link rel="stylesheet" href="/assets/css/styles.css">

  {# --- JSON-LD schema, built centrally from data + per-page flags (Spec §4.4) --- #}
  {%- if schemaOrg -%}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": site.url + "/#organization",
    "name": site.name,
    "url": site.url,
    "email": site.email,
    "logo": "/favicon-192.png" | absoluteUrl(site.url),
    "description": site.description,
    "sameAs": [site.amazonAuthorUrl] if site.amazonAuthorUrl else []
  } | dump | safe }}</script>
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": site.url + "/#website",
    "name": site.name,
    "url": site.url,
    "publisher": { "@id": site.url + "/#organization" }
  } | dump | safe }}</script>
  {%- endif -%}

  {%- if schemaPerson -%}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": page.url | absoluteUrl(site.url),
    "url": page.url | absoluteUrl(site.url),
    "name": title,
    "mainEntity": {
      "@type": "Person",
      "@id": site.authorUrl + "#person",
      "name": site.authorPenName,
      "url": site.authorUrl,
      "jobTitle": "Author and founder",
      "worksFor": { "@id": site.url + "/#organization" }
    }
  } | dump | safe }}</script>
  {%- endif -%}

  {%- if schemaBooks -%}
    {%- for b in books -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Book",
    "@id": {{ (("/book/" + b.slug + "/#book") | absoluteUrl(site.url)) | dump | safe }},
    "name": {{ b.title | dump | safe }},
    "description": {{ b.blurb | dump | safe }},
    "author": { "@type": "Person", "@id": {{ (site.authorUrl + "#person") | dump | safe }}, "name": {{ site.authorPenName | dump | safe }}, "url": {{ site.authorUrl | dump | safe }} },
    "publisher": { "@type": "Organization", "@id": {{ (site.url + "/#organization") | dump | safe }}, "name": {{ site.name | dump | safe }}, "url": {{ site.url | dump | safe }} },
    "bookFormat": "https://schema.org/Hardcover",
    "inLanguage": "en",
    "typicalAgeRange": "2-7",
    "image": {{ (b.cover | absoluteUrl(site.url)) | dump | safe }},
    "url": {{ (("/book/" + b.slug + "/") | absoluteUrl(site.url)) | dump | safe }},
    "mainEntityOfPage": {{ (("/book/" + b.slug + "/") | absoluteUrl(site.url)) | dump | safe }},
    "sku": {{ (b.asin if b.asin else b.slug) | dump | safe }}{% if b.status == "live" and b.asin %},
    "offers": {
      "@type": "Offer",
      "price": {{ site.bookPrice | dump | safe }},
      "priceCurrency": {{ site.currency | dump | safe }},
      "availability": "https://schema.org/InStock",
      "url": {{ (b.asin | amazonUrl(site.associateTag)) | dump | safe }}
    }{% endif %}
  }
  </script>
    {%- endfor -%}
  {%- endif -%}

  {%- if schemaBook -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Book",
    "@id": {{ ((page.url + "#book") | absoluteUrl(site.url)) | dump | safe }},
    "name": {{ book.title | dump | safe }},
    "description": {{ book.blurb | dump | safe }},
    "author": { "@type": "Person", "@id": {{ (site.authorUrl + "#person") | dump | safe }}, "name": {{ site.authorPenName | dump | safe }}, "url": {{ site.authorUrl | dump | safe }} },
    "publisher": { "@type": "Organization", "@id": {{ (site.url + "/#organization") | dump | safe }}, "name": {{ site.name | dump | safe }}, "url": {{ site.url | dump | safe }} },
    "bookFormat": "https://schema.org/Hardcover",
    "inLanguage": "en",
    "typicalAgeRange": "2-7",
    "image": {{ (book.cover | absoluteUrl(site.url)) | dump | safe }},
    "url": {{ (page.url | absoluteUrl(site.url)) | dump | safe }},
    "mainEntityOfPage": {{ (page.url | absoluteUrl(site.url)) | dump | safe }},
    {% if book.isbn13 %}"isbn": {{ book.isbn13 | dump | safe }},{% endif %}
    {% if book.pageCount %}"numberOfPages": {{ book.pageCount | dump | safe }},{% endif %}
    {% if book.datePublished %}"datePublished": {{ book.datePublished | dump | safe }},{% endif %}
    "sku": {{ (book.asin if book.asin else book.slug) | dump | safe }}{% if book.status == "live" and book.asin %},
    "offers": {
      "@type": "Offer",
      "price": {{ site.bookPrice | dump | safe }},
      "priceCurrency": {{ site.currency | dump | safe }},
      "availability": "https://schema.org/InStock",
      "url": {{ (book.asin | amazonUrl(site.associateTag)) | dump | safe }}
    }{% endif %}
  }
  </script>
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
      { "@type": "ListItem", "position": 2, "name": "Books", "item": site.url + "/books/" },
      { "@type": "ListItem", "position": 3, "name": book.title, "item": page.url | absoluteUrl(site.url) }
    ]
  } | dump | safe }}</script>
  {%- endif -%}

  {%- if schemaFaq -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for item in faqs %}
      { "@type": "Question", "name": {{ item.q | dump | safe }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | striptags | dump | safe }} } }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {%- endif -%}

  {%- if schemaArticle -%}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": (page.url + "#article") | absoluteUrl(site.url),
    "headline": title,
    "description": description,
    "image": ogImage | absoluteUrl(site.url) if ogImage else ("/assets/og/default.png" | absoluteUrl(site.url)),
    "datePublished": page.date | isoDate,
    "dateModified": page.date | isoDate,
    "author": { "@type": "Person", "@id": site.authorUrl + "#person", "name": site.authorPenName, "url": site.authorUrl },
    "publisher": { "@type": "Organization", "@id": site.url + "/#organization", "name": site.name, "url": site.url },
    "mainEntityOfPage": page.url | absoluteUrl(site.url)
  } | dump | safe }}</script>
  {%- endif -%}

  {%- if breadcrumbs -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {%- for crumb in breadcrumbs %}
      { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ crumb.name | dump | safe }}, "item": {{ crumb.url | absoluteUrl(site.url) | dump | safe }} }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {%- endif -%}

  {# --- Analytics config (consent-gated; tags injected by main.js after accept — Spec §3.5) --- #}
  <script>
    window.MOC_CONFIG = {
      ga4Id: {{ site.ga4Id | dump | safe }}
    };
  </script>
  <script src="/assets/js/main.js" defer></script>
</head>
<body data-page-url="{{ page.url }}"{% if seriesSlug %} data-series="{{ seriesSlug }}"{% endif %}>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/consent.njk" %}
</body>
</html>
