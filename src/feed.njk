---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>The Clay Journal — Made Out of Clay Productions</title>
    <link>{{ site.url }}/blog/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>Warm, gentle two-minute reads for families: faith, big feelings, neurodivergent kids, and cozy family life.</description>
    <language>en-us</language>
    {%- set latest = collections.posts | first %}
    <lastBuildDate>{{ latest.date | rfc822Date }}</lastBuildDate>
    {%- for post in collections.posts %}
    <item>
      <title><![CDATA[{{ post.data.title }}]]></title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | rfc822Date }}</pubDate>
      <description><![CDATA[{{ post.data.description }}]]></description>
      {%- if post.data.tag %}
      <category><![CDATA[{{ post.data.tag }}]]></category>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
