---
layout: layouts/base.njk
permalink: /books/
title: "All Books — Made Out of Clay Productions"
description: "Browse ten full-color picture books by Isaiah Hartwell across four series, including nine available titles and a free Titus preview."
schemaBooks: true
breadcrumbs:
  - { name: "Home", url: "/" }
  - { name: "Books", url: "/books/" }
---
<section class="page-head">
  <div class="wrap">
    <h1>All Books</h1>
    <p>Ten picture books across four series. Nine are available on Amazon; <em>Titus and the Lions</em> is coming soon with a free read-along preview.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {% for book in books %}
      {%- set s = lookups.seriesBySlug[book.series] -%}
      <article class="book-detail" id="{{ book.slug }}">
        <picture>
          <source srcset="{{ book.cover | assetVariant('avif') }}" type="image/avif">
          <source srcset="{{ book.cover | assetVariant('webp') }}" type="image/webp">
          <img src="{{ book.cover }}" alt="{{ book.alt }}" width="280" height="280" loading="lazy" decoding="async">
        </picture>
        <div>
          <p class="book-card-series" style="color: {{ s.accentText or s.accent }}">{{ s.name }}{% if book.order %} · Book {{ book.order }}{% endif %}</p>
          <h2>{{ book.title }}</h2>
          <p>{{ book.blurb }}</p>
          <div class="themes">
            {% for t in book.themes %}<span class="theme-tag">{{ t }}</span>{% endfor %}
          </div>
          <p class="book-meta">Hardcover · 8.5×8.5 full color · ${{ site.bookPrice }}</p>
          {% if book.status == "live" and book.asin %}
          <a class="btn btn-primary"
             href="{{ book.asin | amazonUrl(site.associateTag) }}"
             target="_blank" rel="sponsored noopener"
             data-track="buy_on_amazon_click"
             data-book-title="{{ book.title }}" data-asin="{{ book.asin }}" data-series="{{ book.series }}">
            Buy on Amazon
          </a>
          <p class="affiliate-note">As an Amazon Associate I earn from qualifying purchases.</p>
          {% else %}
          <span class="btn btn-disabled" aria-disabled="true">Coming Soon</span>
          {% if book.readUrl %}<a class="text-link" href="{{ book.readUrl }}">Read the free preview</a>{% endif %}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<aside class="section section-compact" aria-label="Purchase disclosure">
  <div class="wrap prose purchase-disclosure">
    <p><strong>Purchase disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. You pay the same price, and eligible commissions help support Made Out of Clay Productions. <a href="/affiliate-disclosure/">Read the full disclosure.</a></p>
  </div>
</aside>

{% include "partials/faq.njk" %}
