---
layout: layouts/base.njk
pagination:
  data: books
  size: 1
  alias: book
  addAllPagesToCollections: true
permalink: "/book/{{ book.slug }}/"
eleventyComputed:
  title: "{{ book.title }} — Made Out of Clay Productions"
  metaTitle: "{{ book.title }} | Made Out of Clay"
  description: "{{ book.blurb }}"
  ogImage: "{{ book.cover }}"
  seriesSlug: "{{ book.series }}"
schemaBook: true
---
{%- set s = lookups.seriesBySlug[book.series] -%}
<section class="page-head">
  <div class="wrap">
    <p class="book-card-series" style="color: {{ s.accentText or s.accent }}">
      <a href="/series/{{ s.slug }}/" style="color: inherit; text-decoration: none;">{{ s.name }}</a>{% if book.order %} · Book {{ book.order }}{% endif %}
    </p>
    <h1>{{ book.title }}</h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <article class="book-detail" data-product-title="{{ book.title }}" data-product-series="{{ book.series }}">
      <picture>
        <source srcset="{{ book.cover | assetVariant('avif') }}" type="image/avif">
        <source srcset="{{ book.cover | assetVariant('webp') }}" type="image/webp">
        <img src="{{ book.cover }}" alt="{{ book.alt }}" width="280" height="280" decoding="async">
      </picture>
      <div>
        <p>{{ book.blurb }}</p>
        <div class="themes">
          {% for t in book.themes %}<span class="theme-tag">{{ t }}</span>{% endfor %}
        </div>
        <p class="book-best"><strong>Best for:</strong> {{ book.bestFor }}</p>
        {% if book.faithNote %}<p class="content-note"><strong>Faith note:</strong> {{ book.faithNote }}</p>{% endif %}
        <p class="book-meta">Hardcover · 8.5×8.5 full color · ${{ site.bookPrice }} · Ages {{ site.printAgeRange }}</p>
        {% if book.status == "live" and book.asin %}
        <p class="affiliate-note affiliate-note-prominent">Affiliate disclosure: As an Amazon Associate I earn from qualifying purchases. You pay the same price.</p>
        <a class="btn btn-primary"
           href="{{ book.asin | amazonUrl(site.associateTag) }}"
           target="_blank" rel="sponsored noopener"
           data-track="buy_on_amazon_click"
           data-book-title="{{ book.title }}" data-asin="{{ book.asin }}" data-series="{{ book.series }}">
          Buy on Amazon — ${{ site.bookPrice }}
        </a>
        {% else %}
        <span class="btn btn-disabled" aria-disabled="true">Coming Soon</span>
        {% endif %}
        {% if book.readUrl %}
        <a class="btn btn-primary" href="{{ book.readUrl }}"
           data-track="preview_start" data-book-title="{{ book.title }}">
          📖 Read it free
        </a>
        {% endif %}
        {% if book.previewUrl %}
        <a class="btn btn-secondary" href="{{ book.previewUrl }}"
           data-track="preview_start" data-book-title="{{ book.title }}">
          Look inside free
        </a>
        {% endif %}
        <p style="margin-top: 16px;"><a href="/series/{{ s.slug }}/">More from {{ s.name }} →</a> · <a href="/books/">All books</a></p>
      </div>
    </article>

    <div class="book-guide-grid">
      <section class="content-panel">
        <h2>What families will find</h2>
        <p><em>{{ book.title }}</em> is a picture-book story for ages {{ site.printAgeRange }} built around
          {% for theme in book.themes %}{% if not loop.first %}{% if loop.last %} and {% else %}, {% endif %}{% endif %}{{ theme }}{% endfor %}.
          It works as a shared read-aloud, and it can be read on its own even when it belongs to a series.</p>
        <p>Use the story as an opening for a gentle conversation, then let the child decide how much they want to say. There is no single “right” response to a picture book.</p>
      </section>
      <section class="content-panel">
        <h2>Before you choose</h2>
        <dl class="book-facts">
          <div><dt>Suggested audience</dt><dd>Ages {{ site.printAgeRange }} with an adult reader</dd></div>
          <div><dt>Edition</dt><dd>{% if book.status == "live" %}Hardcover, 8.5×8.5, full color{% else %}Coming soon; free online preview available{% endif %}</dd></div>
          {% if book.pageCount %}<div><dt>Page count</dt><dd>{{ book.pageCount }}</dd></div>{% endif %}
          {% if book.isbn13 %}<div><dt>ISBN-13</dt><dd>{{ book.isbn13 }}</dd></div>{% endif %}
          {% if book.datePublished %}<div><dt>Published</dt><dd>{{ book.datePublished }}</dd></div>{% endif %}
          <div><dt>Language</dt><dd>English</dd></div>
          <div><dt>Series</dt><dd><a href="/series/{{ s.slug }}/">{{ s.name }}</a>{% if book.order %}, Book {{ book.order }}{% endif %}</dd></div>
          <div><dt>Author</dt><dd><a href="/author/" rel="author">{{ site.authorPenName }}</a></dd></div>
        </dl>
      </section>
    </div>

    <section class="content-panel reading-prompts">
      <h2>Questions to ask after reading</h2>
      <ul>{% for question in book.questions %}<li>{{ question }}</li>{% endfor %}</ul>
    </section>

    <section class="content-panel book-access">
      <h2>For libraries, classrooms, and reviewers</h2>
      <p>Need catalog details, a classroom set, wholesale information, or a review copy? Tell us the title and how you plan to use it.</p>
      <p><a href="https://club.madeoutofclayprod.com/schools">School and library inquiries</a> · <a href="mailto:{{ site.email }}?subject=Review%20copy%20request%3A%20{{ book.title | urlencode }}">Request a review copy</a></p>
    </section>
  </div>
</section>

{% if book.previewUrl %}
<section class="section section-alt look-inside" aria-labelledby="look-inside-title">
  <div class="wrap">
    <h2 class="section-title" id="look-inside-title">Look inside</h2>
    <p class="section-intro">A few interior spreads from the free digital edition. Open the Reader for the complete story.</p>
    <div class="spread-grid">
      {% for number in [1, 2, 3] %}
      <img src="https://club.madeoutofclayprod.com/assets/club/{{ book.slug }}/spread-0{{ number }}.webp" alt="Interior spread {{ number }} from {{ book.title }}" width="800" height="800" loading="lazy" decoding="async">
      {% endfor %}
    </div>
    <p class="section-action"><a class="btn btn-primary" href="{{ book.previewUrl }}" data-track="preview_start" data-book-title="{{ book.title }}">Open the complete free preview</a></p>
  </div>
</section>
{% endif %}

{% if book.songVideo %}
<section class="section section-alt" id="song">
  <div class="wrap wrap-narrow" style="text-align: center;">
    <h2 class="section-title">🎵 The song from this book</h2>
    <p>"{{ book.songTitle }}" — sing it together. Fair warning: it will be stuck in your head by bedtime.</p>
    <video controls preload="none" playsinline
           poster="{{ book.cover | assetVariant('webp') }}"
           style="width: 100%; max-width: 720px; border-radius: 12px; margin-top: 16px;"
           data-track="song_video_play" data-book-title="{{ book.title }}">
      <source src="{{ book.songVideo }}" type="video/mp4">
      Your browser doesn't support embedded video.
    </video>
  </div>
</section>
{% endif %}

{%- set seriesBooks = [] -%}
{%- for b in books -%}
  {%- if b.series == book.series and b.slug != book.slug -%}
    {%- set seriesBooks = (seriesBooks.push(b), seriesBooks) -%}
  {%- endif -%}
{%- endfor -%}
{%- if seriesBooks.length > 0 %}
<section class="section" style="background: {{ s.accentSoft }};">
  <div class="wrap">
    <h2>More in this series</h2>
    <div class="book-grid">
      {%- for b in seriesBooks %}
      <a class="book-card related-book-card" href="/book/{{ b.slug }}/">
        <picture>
          <source srcset="{{ b.cover | assetVariant('avif') }}" type="image/avif">
          <source srcset="{{ b.cover | assetVariant('webp') }}" type="image/webp">
          <img src="{{ b.cover }}" alt="{{ b.alt }}" width="220" height="220" loading="lazy" decoding="async">
        </picture>
        <h3>{{ b.title }}</h3>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<div class="sticky-book-action" aria-label="Book actions">
  <span>{{ book.title }}</span>
  {% if book.status == "live" and book.asin %}
  <a class="btn btn-primary" href="{{ book.asin | amazonUrl(site.associateTag) }}" target="_blank" rel="sponsored noopener" data-track="buy_on_amazon_click" data-book-title="{{ book.title }}" data-asin="{{ book.asin }}" data-series="{{ book.series }}">Buy</a>
  {% elif book.readUrl %}
  <a class="btn btn-primary" href="{{ book.readUrl }}" data-track="preview_start" data-book-title="{{ book.title }}">Read free</a>
  {% endif %}
</div>
