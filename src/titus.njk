<style>
  .titus-hero { padding: 56px 0 48px; background: #fdf3d7; border-bottom: 1px solid var(--line); }
  .titus-hero-inner { display: grid; grid-template-columns: .8fr 1.2fr; gap: 44px; align-items: center; }
  @media (max-width: 820px) { .titus-hero-inner { grid-template-columns: 1fr; text-align: center; } }
  .titus-hero-inner img { max-width: 280px; width: 100%; margin: 0 auto; display: block; filter: drop-shadow(0 14px 24px rgba(176,125,10,.25)); }
  .titus-hero .eyebrow { color: #b07d0a; }
  .titus-hero h1 { color: #8a5f06; }
  .titus-satchel { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #f0dca3; border-radius: 999px; padding: 10px 18px; font-weight: 600; color: #8a5f06; margin-top: 8px; }

  /* Front-and-center song card — the whole point of the page. */
  @keyframes titusPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(240,178,41,.55), 0 16px 36px rgba(176,125,10,.22); } 50% { box-shadow: 0 0 0 14px rgba(240,178,41,0), 0 16px 36px rgba(176,125,10,.22); } }
  .titus-song { max-width: 680px; margin: 34px auto 0; background: var(--white); border: 2px solid #f0b429; border-radius: 22px; padding: 30px 28px; text-align: center; animation: titusPulse 2.6s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .titus-song { animation: none; } .titus-sticky { transition: none; } }
  .titus-song .titus-song-badge { display: inline-block; background: #f0b429; color: #5c3f05; font-weight: 800; font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; padding: 5px 14px; border-radius: 999px; margin-bottom: 12px; }
  .titus-song h2 { margin: 0 0 4px; font-size: 1.5rem; color: #8a5f06; }
  .titus-song p.sub { color: var(--ink-soft); margin: 0 0 18px; }
  .titus-song audio { width: 100%; }
  .titus-song audio::-webkit-media-controls-panel { background: #fdf3d7; }
  .titus-song .video-link { margin-top: 16px; font-size: .92rem; }
  @media (max-width: 480px) { .titus-song { padding: 24px 18px; } }

  /* Sticky mini-player — appears once the main song card scrolls out of view,
     so the song stays reachable no matter where you are on the page. */
  .titus-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: #8a5f06; color: #fff;
    display: flex; align-items: center; gap: 14px; padding: 12px 18px; box-shadow: 0 -8px 24px rgba(0,0,0,.18);
    transform: translateY(120%); transition: transform .3s ease; }
  .titus-sticky.show { transform: translateY(0); }
  .titus-sticky-play { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 50%; background: #f0b429; color: #5c3f05;
    border: none; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .titus-sticky-label { flex: 1; font-weight: 700; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .titus-sticky-close { flex: 0 0 auto; background: none; border: none; color: #f1d9a8; font-size: 1.3rem; line-height: 1; cursor: pointer; padding: 4px 6px; }
  @media (max-width: 480px) { .titus-sticky-label { font-size: .85rem; } }

  .titus-promise { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 8px; }
  @media (max-width: 820px) { .titus-promise { grid-template-columns: 1fr; } }
  .titus-promise-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 22px; text-align: center; box-shadow: var(--shadow-sm); }
  .titus-promise-card .emoji { font-size: 2rem; }
  .titus-promise-card h3 { margin: 10px 0 6px; }
  .titus-promise-card p { color: var(--ink-soft); font-size: .95rem; }

  .titus-sheet { max-width: 720px; margin: 0 auto; border-radius: var(--radius); border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
</style>

<section class="titus-hero">
  <div class="wrap titus-hero-inner">
    <img src="/assets/titus-hero.jpg" alt="Titus, a curious little white lamb wearing a small brown satchel" width="338" height="542">
    <div>
      <p class="eyebrow">A little lamb with big questions</p>
      <h1>Meet Titus</h1>
      <p class="lead">Every week, Titus pulls a question out of the satchel — the kind a curious 4-year-old would ask — and a Bible story answers it with a song you won't get out of your head.</p>
      <div class="titus-satchel">🎒 "Why did the shepherd leave the ninety-nine?"</div>
    </div>
  </div>

  <div class="wrap">
    <div class="titus-song" id="titusSong">
      <span class="titus-song-badge">🎵 Press play</span>
      <h2>God Shut the Lions&rsquo; Mouths!</h2>
      <p class="sub">Titus's first earworm — warning: it's contagious.</p>
      <audio id="titusAudio" controls preload="none" data-track="titus_song_play">
        <source src="https://pub-a1fde819eeae4431a2e0c147bb4c10a9.r2.dev/titus/god-shut-the-lions-mouths.mp3" type="audio/mpeg">
        Your browser doesn't support embedded audio.
      </audio>
      <p class="video-link"><a class="btn btn-secondary" href="/series/titus-the-lamb/#sing-along">Watch the full sing-along video &rarr;</a></p>
    </div>
  </div>
</section>

<div class="titus-sticky" id="titusSticky">
  <button type="button" class="titus-sticky-play" id="titusStickyPlay" aria-label="Play or pause the song">▶</button>
  <span class="titus-sticky-label">🎵 God Shut the Lions&rsquo; Mouths! — Titus the Lamb</span>
  <button type="button" class="titus-sticky-close" id="titusStickyClose" aria-label="Hide player">&times;</button>
</div>

<script>
  (function () {
    var audio = document.getElementById("titusAudio");
    var card = document.getElementById("titusSong");
    var sticky = document.getElementById("titusSticky");
    var stickyPlay = document.getElementById("titusStickyPlay");
    var stickyClose = document.getElementById("titusStickyClose");
    if (!audio || !card || !sticky) return;

    var dismissed = false;
    stickyClose.addEventListener("click", function () {
      dismissed = true;
      sticky.classList.remove("show");
    });
    stickyPlay.addEventListener("click", function () {
      if (audio.paused) audio.play(); else audio.pause();
    });
    audio.addEventListener("play", function () { stickyPlay.textContent = "⏸"; });
    audio.addEventListener("pause", function () { stickyPlay.textContent = "▶"; });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        var visible = entries[0].isIntersecting;
        if (!visible && !dismissed) sticky.classList.add("show");
        else if (visible) sticky.classList.remove("show");
      }, { threshold: 0 }).observe(card);
    }
  })();
</script>

